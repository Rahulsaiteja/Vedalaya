PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smartlearn
JWT_SECRET=change_me_to_a_long_random_secret_min_16_chars
JWT_EXPIRES_IN=7d

# Set this to your deployed frontend URL in production (e.g. https://yourapp.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Use onboarding@resend.dev for testing, or your verified domain address in production
SMTP_FROM="Vedalaya Auth" <onboarding@resend.dev>

# Ollama (local LLM — not needed if using Gemini only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Cloudinary (video/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ML backend URL — set to your deployed ML service URL in production
ML_SERVICE_URL=http://localhost:5001

# Google Gemini API key (for chatbot)
GEMINI_API_KEY=your_gemini_api_key

# Shared secret for ML→backend webhook (must match WEBHOOK_SECRET in ml_backend)
WEBHOOK_SECRET=change_me_to_a_random_secret
