**/node_modules/
**/.env
**/.env.local
**/.env.*.local
**/dist/
**/.DS_Store
**/.vite/
**/coverage/
**/*.log

# Model files — large binaries, not for git
ml_backend/*.h5
ml_backend/*.keras

# Dataset — large image collection, not for git
ml_backend/dataset/

# DNN detector weights — downloaded at runtime
ml_backend/deploy.prototxt
ml_backend/res10_300x300_ssd_iter_140000.caffemodel

# Temp files
ml_backend/temp_incoming_face.jpg

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# Scratch / test files
backend/scratch*.js
backend/test*.js
backend/check_*.js
backend/error_std.txt
backend/otp_output.json
