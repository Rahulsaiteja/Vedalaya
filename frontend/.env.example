# Backend API base URL
# In development: leave as /api (Vite proxy handles it)
# In production (Vercel): set to your deployed backend URL e.g. https://your-backend.onrender.com/api
VITE_API_BASE=/api

# ML backend URL — must be set in production to your deployed ML service URL
# e.g. https://your-ml-backend.onrender.com
VITE_ML_API_BASE=http://localhost:5001
